# Copier ce fichier en `.env.local` (Vite) ou `.env` (selon votre outil) et
# remplacer les valeurs par celles de VOTRE projet Supabase.
# Dashboard Supabase > Project Settings > API.

VITE_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
VITE_SUPABASE_ANON_KEY=VOTRE_CLE_ANON_PUBLIQUE

# La "service_role key" (droits complets) ne doit JAMAIS figurer dans ce
# fichier ni dans le frontend. Elle n'est utilisée que côté Edge Functions
# (ex: suppression de compte) — configurée séparément dans le Dashboard
# Supabase, jamais commitée.
